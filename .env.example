# Docker port binding
PORT=127.0.0.1:25565:25565

# Minecraft bot connection parameters
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=Ollama
# Protocol version forced on the bot (default 1.20.4)
# MC_VERSION=1.20.4
MC_PASSWORD=ChangeThisPassword
# Set to false if the server has no /register /login plugin (default: true when MC_PASSWORD is set)
# MC_AUTH_PLUGIN=true

# Read-only status API for the stats dashboard (disabled when BOT_API_PORT is empty or 0).
# The key is required: send it in the X-API-Key header. Generate one with: openssl rand -hex 32
# BOT_API_PORT=3100
# BOT_API_HOST=0.0.0.0
# BOT_API_KEY=

# Local Ollama models (Dual-Model Architecture)
OLLAMA_MODEL=qwen3.5:9B
OLLAMA_MODEL_PLAYER=qwen3.5:9B
OLLAMA_MODEL_MANAGER=qwen3.5:9B

# Optional tuning (defaults shown)
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=512
# SPAWN_PROTECTION_RADIUS=16
# OLLAMA_KEEP_ALIVE=30m
# DETERMINISTIC_PLANNER=true
# REQUIRE_SPAWN_BED=true
# EYE_TRIANGULATION_BASELINE=250
# ENABLE_PROCEDURE_GENERATION=true